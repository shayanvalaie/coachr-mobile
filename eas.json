{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_FASTAPI_BASE_URL": "http://localhost:8000",
        "EXPO_PUBLIC_ENABLE_ADS": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_FASTAPI_BASE_URL": "https://api.coachrapp.io",
        "EXPO_PUBLIC_ENABLE_ADS": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_FASTAPI_BASE_URL": "https://api.coachrapp.io",
        "EXPO_PUBLIC_ENABLE_ADS": "true",
        "EXPO_PUBLIC_LINEUP_INTERSTITIAL_IOS": "ca-app-pub-6570831504802772/8125304855"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6777554380"
      }
    }
  }
}
